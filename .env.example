# ─── Runtime ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://voicelab:voicelab@localhost:5432/voicelab

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-32-plus-character-random-string

# ─── First Admin (seed) ─────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-before-running-seed

# ─── Test users (seed) ──────────────────────────────────────────
# Upstream key reused for basic@voicelab.local + pro@voicelab.local.
# Shared password is hard-coded inside packages/db/src/seed.ts (TEST_USER_PASSWORD).
# Encrypted with ELEVENLABS_KEY_ENCRYPTION_SECRET above.
SEED_ELEVENLABS_API_KEY=sk_replace_with_real_paid_key

# ─── Upstream voice AI (per-user managed) ───────────────────────
# This is the encryption key for the per-user API keys stored in users.elevenlabsApiKey.
# Generate with: openssl rand -base64 32
# Keep it separate from SESSION_SECRET. If rotated, all stored keys must be re-encrypted.
ELEVENLABS_KEY_ENCRYPTION_SECRET=replace-with-32-byte-key

# Single shared key used ONLY for the Free tier demo account.
# See docs/decisions/004-per-user-managed-api-key.md for the operational protocol.
ELEVENLABS_DEMO_API_KEY=sk-demo-account-key-here

# ─── Email (verification + future transactional) ────────────────
# Local dev: Mailpit on localhost:1025 (no auth)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VoiceLab <hello@voicelab.local>

# Verification token lifetime in hours
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# Resend (production example — leave commented in dev)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=VoiceLab <hello@voicelab.com>

# ─── Storage ────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Required when STORAGE_DRIVER=s3 (AWS S3 or Cloudflare R2)
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ─── Free tier credit pricing ───────────────────────────────────
# Free tier only — paid users use upstream metering (no app-level credits).
# See docs/decisions/005-credit-system-design.md.
CREDIT_PER_CHAR_TTS=1.0
# One-time grant on email verification. Cannot be renewed.
FREE_TIER_INITIAL_CREDITS=1000

# ─── Billing (future — Stripe) ──────────────────────────────────
# Leave empty for MVP; manual upgrade flow via admin panel.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_BASIC=
# STRIPE_PRICE_ID_PRO=

# ─── Monitoring (optional) ──────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=VoiceLab

{
  "name": "voicelab",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --hot apps/api/src/index.ts",
    "lint": "echo \"lint not configured yet\" && exit 0",
    "typecheck": "bun --cwd apps/api typecheck && bun --cwd packages/db typecheck && bun --cwd packages/shared typecheck",
    "test": "bun test",
    "db:generate": "bun --cwd packages/db db:generate",
    "db:migrate": "bun --cwd packages/db db:migrate",
    "db:seed": "bun --cwd packages/db db:seed",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.2"
  },
  "simple-git-hooks": {
    "pre-push": "bun run test && bun run lint && bun run typecheck"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
